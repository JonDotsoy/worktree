{
  "name": "worktree",
  "displayName": "Worktree",
  "description": "Visualiza y gestiona los git worktrees desde Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "jondotsoy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonDotsoy/worktree"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktree",
          "title": "Worktree",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktree": [
        {
          "id": "worktree.list",
          "name": "Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktree.list",
        "contents": "Aquí se mostrarán los worktrees del repositorio."
      }
    ]
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --outdir ./dist --target node --format cjs --external vscode --sourcemap=linked",
    "watch": "bun run build --watch",
    "typecheck": "tsc --noEmit",
    "ext:dev": "bun run build && code --extensionDevelopmentPath=\"$PWD\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/vscode": "~1.90.0",
    "typescript": "^5.6.0"
  }
}
