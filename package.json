{
  "name": "worktree",
  "displayName": "Worktree",
  "description": "Visualiza y gestiona los git worktrees desde Visual Studio Code.",
  "version": "0.0.7",
  "publisher": "jondotsoy",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonDotsoy/worktree"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktree",
          "title": "Worktree",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktree": [
        {
          "type": "webview",
          "id": "worktree.list",
          "name": "Worktrees"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun build ./src/extension.ts --outdir ./dist --target node --format cjs --external vscode --sourcemap=linked",
    "watch": "bun run build --watch",
    "screenshots": "bun scripts/screenshots.ts",
    "icon": "bun scripts/icon.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "package": "vsce package --no-dependencies --skip-license",
    "ext:dev": "bun run build && code --extensionDevelopmentPath=\"$PWD\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0"
  }
}
